# ---- Supabase ----
# Found in Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose this to the browser

# ---- Paystack ----
# Found in Paystack dashboard > Settings > API Keys & Webhooks
# Start with TEST keys until you're ready to go live
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx

# ---- Anthropic (AI screenshot verification) ----
# Found at console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ---- App ----
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ---- Automated weekly payout (Vercel Cron) ----
# Any long random string you make up yourself — protects the payout endpoint
# from being triggered by anyone who isn't Vercel's own scheduler.
CRON_SECRET=make-up-a-long-random-string-here

# ---- Free task alerts: web push (no per-message cost) ----
# Generate once with:  npx web-push generate-vapid-keys
# The public key is safe to expose; keep the private key secret. Set all three in Vercel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:info@primeloop.app

# ---- WhatsApp Channel (free, posted by an admin with one click) ----
# Create a Channel in the WhatsApp app, then paste its link here.
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/your-channel-id

# ---- WhatsApp Cloud API (PAID per message; task alerts to engagers) ----
# Leave WHATSAPP_ALERTS_ENABLED unset to keep it off. Meta charges for every
# delivered template message, so nothing is sent unless this is exactly "true".
# WHATSAPP_ALERTS_ENABLED=true
# From developers.facebook.com — see GETTING_STARTED.md for full setup,
# including the required message template approval (not instant).
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_TEMPLATE_NAME=new_task_alert

# ---- Free trial for new clients ----
# How many free trials can be given out in any rolling 7 days, across the whole
# platform. Each trial costs roughly the engager payouts for 5 likes + 2 comments
# (about ₦35). Optional — defaults to 40. See /admin/accounting for actual usage.
TRIAL_WEEKLY_CAP=40

# ---- Meta Pixel (Facebook/Instagram ad tracking) ----
# From Meta Business Manager > Events Manager > your pixel. Leave blank
# until you have one — the app works fine without it, tracking just won't
# fire.
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Google Analytics 4 ----
# From analytics.google.com > Admin > Data Streams > your web stream.
# Leave blank until you have one — the app works fine without it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Business rules (optional; sensible defaults are built in) ----
# Earnings below this many naira roll over to the next Friday instead of being paid
# (each bank transfer has a fee). Shown on the site too. 0 switches it off.
NEXT_PUBLIC_MIN_PAYOUT_NAIRA=500
# Smallest order a client can pay for. 0 switches it off.
NEXT_PUBLIC_MIN_ORDER_NAIRA=500

# ---- AI screenshot checking ----
# Needs a valid key from console.anthropic.com. Set a monthly spend limit there.
# ANTHROPIC_API_KEY=your-key
# Model used to read screenshots. A small model is cheap and reads them well.
# AI_VERIFY_MODEL=claude-haiku-4-5-20251001
# Trust-based checking: what earns an engager automatic approval (with spot checks).
# TRUST_MIN_APPROVED=20        approved tasks needed
# TRUST_MAX_REJECT_RATE=0.05   at most 5% rejected
# TRUST_QUIET_DAYS=14          any rejection in this many days puts them back on full checks
